{
  "name": "@tapayadot/checkout",
  "version": "0.2.0",
  "description": "Tapaya Checkout SDK: server client, browser loader, and React hook",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "deno": "./dist/index.js",
      "bun": "./dist/index.js",
      "workerd": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "worker": "./dist/index.js",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/client/react.d.ts",
      "import": "./dist/client/react.js"
    }
  },
  "sideEffects": [
    "./dist/browser.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && node --test scripts/release-checks.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "26.6.2",
    "@types/react": "19.2.0",
    "jsdom": "30.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.14.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapayadot/checkout-node.git"
  },
  "homepage": "https://github.com/tapayadot/checkout-node#readme",
  "bugs": {
    "url": "https://github.com/tapayadot/checkout-node/issues"
  }
}
