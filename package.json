{
  "name": "@tapayadot/checkout",
  "version": "0.1.0",
  "description": "Server-side SDK for Tapaya Checkout",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && node --test scripts/release-checks.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.14.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapayadot/checkout-sdk.git"
  },
  "homepage": "https://github.com/tapayadot/checkout-sdk#readme",
  "bugs": {
    "url": "https://github.com/tapayadot/checkout-sdk/issues"
  }
}
